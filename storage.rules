rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    // User-specific files (users can read and write only their own files)
    match /users/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // Chatroom attachments (authenticated users can read, upload with size/type validation, and delete their own files)
    match /chatrooms/{roomId}/{userId}/{messageId}/{fileName} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches(
          '^(image|video|audio)/.*$|^application/(pdf|octet-stream)$'
        );

      allow delete: if signedIn() && request.auth.uid == userId;
      allow update: if false;
    }

    match /room-images/{roomId}/{userId}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId
        && firestore.get(/databases/(default)/documents/chatrooms/$(roomId)).data.createdBy == request.auth.uid
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('^image/(jpeg|png|webp|gif)$');
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /directChats/{roomId}/{userId}/{messageId}/{fileName} {
      function isMember() {
        return signedIn() && request.auth.uid in firestore.get(/databases/(default)/documents/directChats/$(roomId)).data.members;
      }
      allow read: if isMember();
      allow create: if isMember() && request.auth.uid == userId
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('^(image|video|audio)/.*$|^application/(pdf|octet-stream)$');
      allow delete: if isMember() && request.auth.uid == userId;
    }

    // Default fallback: deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
