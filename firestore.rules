rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function room(roomId) {
      return get(/databases/$(database)/documents/chatrooms/$(roomId));
    }

    function isRoomOwner(roomId) {
      return signedIn() && room(roomId).data.createdBy == request.auth.uid;
    }

    // Public rooms: title, owner, createdAt, unique member IDs/count, optional photoURL.
    // Direct chats add immutable participantIds (exactly two); only current members
    // can read messages. Replies store a small author/text snapshot, not a whole message.
    function validRoom(data) {
      return data.keys().hasAll(['title', 'createdBy', 'createdAt', 'members', 'memberCount'])
        && data.keys().hasOnly(['title', 'createdBy', 'createdAt', 'members', 'memberCount', 'photoURL', 'participantIds'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.createdBy is string && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.members is list && data.members.size() <= 1000
        && data.members.toSet().size() == data.members.size()
        && data.memberCount is int && data.memberCount == data.members.size()
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2000 && data.photoURL.matches('https://.*')));
    }

    function selfMembershipChange() {
      let old = resource.data.members.toSet();
      let next = request.resource.data.members.toSet();
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberCount'])
        && next.difference(old).hasOnly([request.auth.uid])
        && old.difference(next).hasOnly([request.auth.uid]);
    }

    function canReadChat(collectionName, roomId) {
      let data = get(/databases/$(database)/documents/$(collectionName)/$(roomId)).data;
      return signedIn() && request.auth.uid in data.members;
    }

    function validMessage(data, collectionName, roomId) {
      return data.keys().hasAll(['userId', 'username', 'message', 'type', 'timestamp', 'createdAtClient'])
        && data.keys().hasOnly(['userId', 'username', 'message', 'type', 'timestamp', 'createdAtClient', 'photoURL', 'replyTo', 'editedAt', 'fileUrl', 'fileType', 'animeData', 'mangaData', 'productData', 'eventData', 'profileData'])
        && data.userId is string && data.userId.size() <= 128
        && data.username is string && data.username.size() <= 320
        && data.message is string && data.message.size() <= 10000
        && data.timestamp is timestamp && data.createdAtClient is number
        && data.type in ['text', 'image', 'video', 'audio', 'file', 'anime_share', 'manga_share', 'product_share', 'event_share', 'profile_share']
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2000))
        && (!('replyTo' in data) || (
          data.replyTo is map && data.replyTo.keys().hasAll(['id', 'userId', 'username', 'preview'])
          && data.replyTo.keys().hasOnly(['id', 'userId', 'username', 'preview'])
          && data.replyTo.id is string && data.replyTo.id.size() <= 128
          && data.replyTo.userId is string && data.replyTo.userId.size() <= 128
          && data.replyTo.username is string && data.replyTo.username.size() <= 320
          && data.replyTo.preview is string && data.replyTo.preview.size() <= 250
        ));
    }

    match /chatrooms/{roomId} {
      allow get, list: if signedIn();
      allow create: if signedIn() && validRoom(request.resource.data)
        && !roomId.matches('dm_.*') && !('participantIds' in request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && validRoom(request.resource.data)
        && !('participantIds' in request.resource.data)
        && (selfMembershipChange() || (resource.data.createdBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'photoURL'])));
      allow delete: if isRoomOwner(roomId);

      match /messages/{messageId} {
        allow read: if canReadChat('chatrooms', roomId);
        allow create: if canReadChat('chatrooms', roomId)
          && validMessage(request.resource.data, 'chatrooms', roomId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.timestamp == request.time;
        allow update: if canReadChat('chatrooms', roomId) && resource.data.userId == request.auth.uid
          && validMessage(request.resource.data, 'chatrooms', roomId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['message', 'editedAt'])
          && request.resource.data.editedAt == request.time;
        allow delete: if canReadChat('chatrooms', roomId) && resource.data.userId == request.auth.uid;
      }
      match /profiles/{userId} {
        function validProfile(data) {
          return data.keys().hasAll(['displayName', 'photoURL']) && data.keys().hasOnly(['displayName', 'photoURL'])
            && data.displayName is string && data.displayName.size() <= 320
            && data.photoURL is string && data.photoURL.size() <= 2000;
        }
        allow read: if canReadChat('chatrooms', roomId);
        allow create, update: if canReadChat('chatrooms', roomId) && request.auth.uid == userId && validProfile(request.resource.data);
      }
      match /typing/{userId} {
        allow read: if canReadChat('chatrooms', roomId);
        allow write: if canReadChat('chatrooms', roomId) && request.auth.uid == userId;
      }
      match /invites/{inviteId} {
        allow read: if isRoomOwner(roomId);
        allow create: if isRoomOwner(roomId) && request.resource.data.invitedBy == request.auth.uid;
        allow update, delete: if isRoomOwner(roomId);
      }
    }

    match /directChats/{roomId} {
      function validDirect(data) {
        return validRoom(data) && data.participantIds is list && data.participantIds.size() == 2
          && data.participantIds[0] is string && data.participantIds[0].size() <= 128
          && data.participantIds[1] is string && data.participantIds[1].size() <= 128
          && data.participantIds[0] != data.participantIds[1]
          && data.members.toSet().difference(data.participantIds.toSet()).size() == 0;
      }
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.participantIds);
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && validDirect(request.resource.data)
        && roomId.matches('dm_[a-f0-9]{64}')
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.members == request.resource.data.participantIds
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && validDirect(request.resource.data)
        && request.auth.uid in resource.data.participantIds && selfMembershipChange();
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if canReadChat('directChats', roomId);
        allow create: if canReadChat('directChats', roomId)
          && validMessage(request.resource.data, 'directChats', roomId)
          && request.resource.data.userId == request.auth.uid && request.resource.data.timestamp == request.time;
        allow update: if canReadChat('directChats', roomId) && resource.data.userId == request.auth.uid
          && validMessage(request.resource.data, 'directChats', roomId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['message', 'editedAt'])
          && request.resource.data.editedAt == request.time;
        allow delete: if canReadChat('directChats', roomId) && resource.data.userId == request.auth.uid;
      }
      match /profiles/{userId} {
        function validProfile(data) {
          return data.keys().hasAll(['displayName', 'photoURL']) && data.keys().hasOnly(['displayName', 'photoURL'])
            && data.displayName is string && data.displayName.size() <= 320
            && data.photoURL is string && data.photoURL.size() <= 2000;
        }
        allow read: if canReadChat('directChats', roomId);
        allow create, update: if canReadChat('directChats', roomId) && request.auth.uid == userId && validProfile(request.resource.data);
      }
      match /typing/{userId} {
        allow read: if canReadChat('directChats', roomId);
        allow write: if canReadChat('directChats', roomId) && request.auth.uid == userId;
      }
    }

    match /users/{userId} {
      // Public user profiles can be viewed by anyone when isPublic is true,
      // while users can always view and manage their own profiles.
      allow get: if (signedIn() && request.auth.uid == userId)
        || (resource != null && resource.data.isPublic == true);
      allow list: if resource.data.isPublic == true
        || (signedIn() && request.auth.uid == userId);
      allow write: if signedIn() && request.auth.uid == userId;

      match /lists/{listId} {
        // Public boards (lists) can be viewed by anyone,
        // while private boards are restricted to the owner.
        allow read: if (signedIn() && request.auth.uid == userId)
          || (resource != null && resource.data.public == true);
        allow write: if signedIn() && request.auth.uid == userId;

        match /items/{itemId} {
          // Items inherit visibility from the parent board (list).
          allow read: if (signedIn() && request.auth.uid == userId)
            || (get(/databases/$(database)/documents/users/$(userId)/lists/$(listId)).data.public == true);
          allow write: if signedIn() && request.auth.uid == userId;
        }
      }

      // Catch-all for any other user subcollections/documents (must remain strictly private).
      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    // Supports the existing collection-group bookmark lookup without exposing
    // another user's saved items.
    match /{path=**}/items/{itemId} {
      allow read: if signedIn() && resource.data.addedBy == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow create: if signedIn()
        && request.resource.data.userId is string
        && request.resource.data.timestamp == request.time;
      allow read, update, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
